{
  "name": "government-procurement-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CMS API for the Government Procurement website (Express + MongoDB + S3)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:team": "node src/seed/seed-team.js",
    "seed:careers": "node src/seed/seed-careers.js",
    "seed:demo-articles": "node src/seed/seed-demo-articles.js",
    "reset:courses": "node src/seed/reset-courses.js",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.15",
    "slugify": "^1.6.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
