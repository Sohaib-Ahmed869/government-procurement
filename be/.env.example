# ---------------------------------------------------------------------------
# Government Procurement — Backend environment
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS).
CLIENT_ORIGINS=http://localhost:5173

# MongoDB — paste your connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/government_procurement

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Separate, shorter-lived secret for password-reset tokens
JWT_RESET_SECRET=change-me-too
JWT_RESET_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# AWS S3 — media & video storage  (paste these after scaffolding)
# ---------------------------------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional: a CDN / custom domain in front of the bucket. If empty, the public
# URL falls back to the standard https://<bucket>.s3.<region>.amazonaws.com/<key>.
S3_PUBLIC_BASE_URL=
# Max upload size in megabytes (videos included)
MAX_UPLOAD_MB=512

# ---------------------------------------------------------------------------
# Email (nodemailer) — OPTIONAL.
# If SMTP_HOST is empty, emails (password reset, double opt-in, Q&A answers,
# discussion notifications) are logged to the console instead of sent, so the
# app runs without mail credentials.
#
# Verify with:  npm run mail:check              settings + authenticate
#               npm run mail:check -- you@x.com also send a real test email
#
# PORT decides the handshake: 465 is SSL, 587 is STARTTLS. The app picks the
# right one from the number, so set the port and leave the rest alone.
#
# SMTP_USER is the FULL email address, and SMTP_PASS is the MAILBOX password —
# not the password for the hosting control panel.
#
# MAIL_FROM must be the same address as SMTP_USER (or a verified alias of it).
# Sending as an unrelated address is rejected by most hosts, Hostinger
# included, and shows up as a 553/550 well after everything looks configured.
#
# Hostinger:  SMTP_HOST=smtp.hostinger.com   SMTP_PORT=465
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Government Procurement <you@yourdomain.com.au>"

# First super-admin — created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Site Admin

# ---------------------------------------------------------------------------
# Encrypted HLS video  (LMS 3.0) — optional
#
# Off unless HLS_KEY_SECRET is set AND lessons have been packaged. With it off,
# lesson video keeps playing through the existing signed-MP4 endpoint, exactly
# as before. Nothing here changes who may watch: the enrolment gate is the same
# one, and it runs again on every key request.
#
# HONEST LIMITS: AES-128 HLS is not DRM. The key is handed to anybody the gate
# lets play, so yt-dlp and ffmpeg can both save the stream. What it buys is that
# there is no single file URL to pass around, a leaked key is worth only its
# rotation group (~1 minute), and revoking an enrolment stops playback mid-watch
# instead of at the next page load. Real protection is Widevine/FairPlay with a
# licence server — and a screen recorder still beats that.

# Root of every content key. Generate with:  npm run hls:secret
# Rotating this invalidates every key at once (the break-glass lever).
# 32+ chars, or serving encrypted video fails loudly rather than quietly.
HLS_KEY_SECRET=

# Segments per key. ~6s segments x 10 is about a minute of video per key.
HLS_KEY_ROTATE_SEGMENTS=10

# How long a playlist's key-URI token stays valid. The gate is re-checked on
# every key request regardless, so this is a second bound, not the access check.
HLS_TOKEN_TTL_SECONDS=300

# Segment length ffmpeg cuts at.
HLS_SEGMENT_SECONDS=6

# Path to an ffmpeg binary. Setting this is what enables packaging.
# LEAVE EMPTY IN THE API PROCESS: ffmpeg is minutes of full-core work per lesson
# and will starve the API. Run `npm run hls:package` on a worker or a laptop.
# Not running media infrastructure at all is a fair choice — see
# src/modules/lms/hlsTranscode.js for the MediaConvert / Mux / Cloudflare route.
FFMPEG_PATH=

# NOTE — S3 CORS. Chrome/Firefox/Edge play HLS through hls.js, which fetches
# segments by XHR, so the bucket needs a CORS rule allowing GET from your site's
# origins. Safari and iOS play natively and do not. Segments are presigned for
# hours rather than minutes on purpose: they are ciphertext, and a leaked
# segment URL without a key is worth nothing.

# ---- Course Coach (LMS 18.0) -------------------------------------------------
# The AI study assistant in the student LMS, at /learn/coach. It answers only
# from the lessons of a course the learner is enrolled in, and refuses real
# procurement advice — that is the Procurement Advisor's job, and that tool is
# contractually not AI. See docs/AI-COACH-PATHWAY.md.
#
# WITHOUT A KEY the coach reports itself unavailable and the screen says so. It
# never falls back to answering from general knowledge: an assistant that quietly
# starts inventing procurement guidance when its credentials lapse is worse than
# one that is plainly switched off.

# WHOSE ACCOUNT is billed. Change this line to move to a different account.
ANTHROPIC_API_KEY=

# Kill switch. `false` turns the coach off with the credentials left in place.
COACH_ENABLED=true

# WHICH VENDOR answers. One adapter per value, in
# src/modules/lms/coach/providers/. Only `anthropic` ships today.
COACH_PROVIDER=anthropic

# WHICH MODEL that vendor is asked for. Change this line alone to move models.
COACH_MODEL=claude-opus-5

# How hard the model works per answer: low | medium | high | xhigh | max.
# `low` suits routine "what did this lesson mean" questions. Raise it if answers
# read as thin; it costs more per answer.
COACH_EFFORT=low

# Questions per learner per hour. An LLM endpoint behind a login with no ceiling
# is a bill waiting to happen. Held in memory, so it is per-instance — see the
# note in coach.controller.js before running more than one container.
COACH_HOURLY_LIMIT=30

# ---------------------------------------------------------------------------
# Live teaching sessions (LMS 17.0) — optional
#
# Sessions are scheduled against a course and the enrolment is the whole access
# model. With no credentials below, scheduling still works and every session
# says plainly that it has no meeting link yet — it never shows a Join button
# that goes nowhere.
#
# HONEST LIMITS: the gate decides who is handed a link, not who gets into the
# room. A learner can forward the link they were given, and Zoom's waiting room
# is what stands between that and a stranger attending. What the gate does buy
# is revocability: unenrol somebody and their next click fails, rather than them
# holding a working link indefinitely.
# ---------------------------------------------------------------------------

# Kill switch. `false` turns scheduling off with the credentials left in place.
LIVE_SESSIONS_ENABLED=true

# Which adapter hosts the meeting. One file per value in
# src/modules/lms/live/providers/. Only `zoom` ships today.
LIVE_PROVIDER=zoom

# Zoom Server-to-Server OAuth app (Marketplace → Develop → Build App →
# Server-to-Server OAuth). Grant it the meeting write scopes — `meeting:write`
# and `meeting:write:admin` — or every call returns 4xx.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Whose Zoom calendar meetings land on. `me` is the account the app belongs to;
# an email or user id puts them on a different licensed host.
ZOOM_USER_ID=me

# ---------------------------------------------------------------------------
# Federated sign-in — "Continue with Google / Microsoft" (L6) — optional
#
# A second WAY IN to the accounts that already exist, not a second account
# system: same users collection, same roles, same JWT. Each provider switches on
# independently when its own credentials are present; with none set, the sign-in
# screen shows only email and password, exactly as before.
#
# HOW ACCOUNTS ARE MATCHED. Only ever on an email the provider says is VERIFIED.
# Without that rule, anyone able to get a token carrying somebody else's address
# could claim their account. Once linked, sign-in matches on the provider's
# immutable subject id instead, so changing an email at the provider cannot move
# the link. A federated login can never create a staff account — new accounts
# are always students, the same rule self-signup follows.
#
# REDIRECT URIs must be registered with each provider EXACTLY, including scheme
# and port. They are built from API_PUBLIC_URL:
#   <API_PUBLIC_URL>/api/auth/oauth/google/callback
#   <API_PUBLIC_URL>/api/auth/oauth/microsoft/callback
# Set API_PUBLIC_URL in production, or the callback points at localhost.
# ---------------------------------------------------------------------------

# Kill switch. `false` hides every button with credentials left in place.
OAUTH_ENABLED=true

# Google: console.cloud.google.com → APIs & Services → Credentials →
# Create Credentials → OAuth client ID → Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Entra ID): portal.azure.com → Microsoft Entra ID → App
# registrations → New registration, then Certificates & secrets for the secret.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common | organizations | consumers | <tenant guid>.
# `common` accepts any Microsoft account and is what a self-serve site wants.
# A tenant guid locks sign-in to ONE organisation and shuts out every other
# buyer — narrow it only when that is genuinely the intent.
MICROSOFT_TENANT=common

# ---------------------------------------------------------------------------
# Payments — Stripe (C1) — required before anything can be bought
#
# PRICES IN THIS SYSTEM ARE TAX-INCLUSIVE. A course priced at 690 means the
# customer pays $690, and the GST is a component already inside it — $62.73,
# because 10% inclusive means the tax is one eleventh of the total, NOT 10% of
# it. See src/utils/gst.js. Stripe is sent the full amount with tax_behavior
# 'inclusive', so the number on the course page is the number on the card
# statement.
#
# Australian Consumer Law wants a single prominent total price for consumers,
# which is the other reason for inclusive: "$690 + GST" on a public page is a
# compliance problem.
#
# Without a secret key the commerce endpoints report themselves unavailable and
# nothing can be bought — no half-working checkout.
# ---------------------------------------------------------------------------

# Kill switch. `false` turns payments off with the keys left in place.
STRIPE_ENABLED=true

# dashboard.stripe.com → Developers → API keys. Use the TEST key (sk_test_…)
# until go-live; the status endpoint reports which mode is in use so a test key
# in production is visible rather than discovered by an uncharged customer.
STRIPE_SECRET_KEY=

# Developers → Webhooks → add endpoint → <API_PUBLIC_URL>/api/lms/commerce/webhook
# Subscribe to: checkout.session.completed, checkout.session.expired,
#               charge.refunded
# Then copy the signing secret (whsec_…) here.
#
# REQUIRED, not optional. The signature is the only thing authenticating that
# endpoint; without it, "mark this order paid" is open to anyone who finds the
# URL. Enrolment is granted by this webhook, never by the browser returning to
# the success page — so a learner who closes the tab is still enrolled, and
# somebody who visits the success URL directly is not.
#
# For local testing:  stripe listen --forward-to localhost:5001/api/lms/commerce/webhook
STRIPE_WEBHOOK_SECRET=

# Stripe product tax code. REQUIRED by Managed Payments (on by default for
# newer accounts) and restricted to an eligibility list — several obvious
# candidates are refused. Verified against the live API:
#
#   INELIGIBLE: txcd_20060044 (Training), txcd_20060052 (Educational Services),
#               txcd_20060045 (Training Services - Live Virtual)
#   ELIGIBLE:   txcd_20060058  Training Services - Self-study Web-based (default)
#               txcd_20060158  On demand Online Courses - streamed AV
#               txcd_20060258  On demand Online Courses - streamed + downloadable
#               txcd_20060358  On demand Online Courses - written material
#
# Which one is correct is a question for your accountant, not a deploy.
STRIPE_TAX_CODE=txcd_20060058
