# ---------------------------------------------------------------------------
# Government Procurement — Backend environment
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS).
CLIENT_ORIGINS=http://localhost:5173

# MongoDB — paste your connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/government_procurement

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Separate, shorter-lived secret for password-reset tokens
JWT_RESET_SECRET=change-me-too
JWT_RESET_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# AWS S3 — media & video storage  (paste these after scaffolding)
# ---------------------------------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional: a CDN / custom domain in front of the bucket. If empty, the public
# URL falls back to the standard https://<bucket>.s3.<region>.amazonaws.com/<key>.
S3_PUBLIC_BASE_URL=
# Max upload size in megabytes (videos included)
MAX_UPLOAD_MB=512

# ---------------------------------------------------------------------------
# Email (nodemailer) — OPTIONAL.
# If SMTP_HOST is empty, emails (password reset, double opt-in) are logged to
# the console instead of sent, so the app runs without mail credentials.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Government Procurement <no-reply@example.com>"

# First super-admin — created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Site Admin

# ---------------------------------------------------------------------------
# Encrypted HLS video  (LMS 3.0) — optional
#
# Off unless HLS_KEY_SECRET is set AND lessons have been packaged. With it off,
# lesson video keeps playing through the existing signed-MP4 endpoint, exactly
# as before. Nothing here changes who may watch: the enrolment gate is the same
# one, and it runs again on every key request.
#
# HONEST LIMITS: AES-128 HLS is not DRM. The key is handed to anybody the gate
# lets play, so yt-dlp and ffmpeg can both save the stream. What it buys is that
# there is no single file URL to pass around, a leaked key is worth only its
# rotation group (~1 minute), and revoking an enrolment stops playback mid-watch
# instead of at the next page load. Real protection is Widevine/FairPlay with a
# licence server — and a screen recorder still beats that.

# Root of every content key. Generate with:  npm run hls:secret
# Rotating this invalidates every key at once (the break-glass lever).
# 32+ chars, or serving encrypted video fails loudly rather than quietly.
HLS_KEY_SECRET=

# Segments per key. ~6s segments x 10 is about a minute of video per key.
HLS_KEY_ROTATE_SEGMENTS=10

# How long a playlist's key-URI token stays valid. The gate is re-checked on
# every key request regardless, so this is a second bound, not the access check.
HLS_TOKEN_TTL_SECONDS=300

# Segment length ffmpeg cuts at.
HLS_SEGMENT_SECONDS=6

# Path to an ffmpeg binary. Setting this is what enables packaging.
# LEAVE EMPTY IN THE API PROCESS: ffmpeg is minutes of full-core work per lesson
# and will starve the API. Run `npm run hls:package` on a worker or a laptop.
# Not running media infrastructure at all is a fair choice — see
# src/modules/lms/hlsTranscode.js for the MediaConvert / Mux / Cloudflare route.
FFMPEG_PATH=

# NOTE — S3 CORS. Chrome/Firefox/Edge play HLS through hls.js, which fetches
# segments by XHR, so the bucket needs a CORS rule allowing GET from your site's
# origins. Safari and iOS play natively and do not. Segments are presigned for
# hours rather than minutes on purpose: they are ciphertext, and a leaked
# segment URL without a key is worth nothing.

# ---- Course Coach (LMS 18.0) -------------------------------------------------
# The AI study assistant in the student LMS, at /learn/coach. It answers only
# from the lessons of a course the learner is enrolled in, and refuses real
# procurement advice — that is the Procurement Advisor's job, and that tool is
# contractually not AI. See docs/AI-COACH-PATHWAY.md.
#
# WITHOUT A KEY the coach reports itself unavailable and the screen says so. It
# never falls back to answering from general knowledge: an assistant that quietly
# starts inventing procurement guidance when its credentials lapse is worse than
# one that is plainly switched off.

# WHOSE ACCOUNT is billed. Change this line to move to a different account.
ANTHROPIC_API_KEY=

# Kill switch. `false` turns the coach off with the credentials left in place.
COACH_ENABLED=true

# WHICH VENDOR answers. One adapter per value, in
# src/modules/lms/coach/providers/. Only `anthropic` ships today.
COACH_PROVIDER=anthropic

# WHICH MODEL that vendor is asked for. Change this line alone to move models.
COACH_MODEL=claude-opus-5

# How hard the model works per answer: low | medium | high | xhigh | max.
# `low` suits routine "what did this lesson mean" questions. Raise it if answers
# read as thin; it costs more per answer.
COACH_EFFORT=low

# Questions per learner per hour. An LLM endpoint behind a login with no ceiling
# is a bill waiting to happen. Held in memory, so it is per-instance — see the
# note in coach.controller.js before running more than one container.
COACH_HOURLY_LIMIT=30
